# Clave API de Anthropic — obtener en console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Proyecto de Supabase (Settings → API en el dashboard de Supabase)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=...           # anon/public key
SUPABASE_SERVICE_KEY=...   # service_role key — requerida para bypassear RLS desde el backend

# Legado de la era SQLite — ya casi no se usa (todo vive en Supabase Storage ahora)
STORAGE_PATH=./storage
